# Normalize line endings. Repo stores text as LF; working tree per platform.
* text=auto

# These MUST stay LF or they break on Linux (shebangs, container builds).
*.sh text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
Caddyfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows scripts stay CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets.
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.webp binary
*.woff binary
*.woff2 binary
