{
  "name": "seosites",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:admin": "npm run dev -w orbit-admin",
    "dev:storefront": "npm run dev -w storefront",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate -w orbit-admin",
    "db:migrate": "npm run db:migrate -w orbit-admin",
    "db:seed": "npm run db:seed -w orbit-admin"
  },
  "engines": {
    "node": ">=20"
  }
}
