# ==========================================================================
# Orbit deployment environment — TEMPLATE (mock values, NO real secrets).
# Copy to `.env` next to docker-compose.yml and replace the placeholders.
#   cp .env.template .env
# ==========================================================================

# ---- Postgres ------------------------------------------------------------
POSTGRES_USER=orbit
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=orbit_admin

# ---- orbit-admin ---------------------------------------------------------
# Points at the compose `postgres` service on the orbit-net network.
DATABASE_URL=postgres://orbit:change-me-postgres-password@postgres:5432/orbit_admin
LOG_LEVEL=info

# Initial admin seeded by `npm run db:seed` (change before production).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin-password

# Root of the ORB-501 media volume. Compose already sets this for the container
# (/srv/orbit-media, a named volume); override only for a host-run dev server,
# where it defaults to apps/orbit-admin/media.
# MEDIA_DIR=/srv/orbit-media

# ---- storefront ----------------------------------------------------------
# Internal URL of the admin content API (@orbit/next consumes this).
ORBIT_API_URL=http://orbit-admin:3000
# Origin the browser loads product images from. Compose derives this from
# ADMIN_DOMAIN below; set it explicitly only to point images somewhere else
# (a CDN), or to "" once a proxy serves the media path on the storefront's own
# origin. Leave unset for host-run dev, where it falls back to ORBIT_API_URL.
# ORBIT_ASSET_BASE_URL=https://admin.example.com

# ---- Caddy / domains -----------------------------------------------------
# Use *.localhost for local testing (Caddy issues an internal cert).
# Use real DNS names in production so Caddy can obtain Let's Encrypt certs.
STOREFRONT_DOMAIN=localhost
ADMIN_DOMAIN=admin.localhost
# Email used for ACME/Let's Encrypt registration (production only).
ACME_EMAIL=admin@example.com
